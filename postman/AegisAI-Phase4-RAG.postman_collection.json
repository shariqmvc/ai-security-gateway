{
  "info": {
    "_postman_id": "aegisai-phase4-rag",
    "name": "AegisAI - Phase 4 RAG Complete",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Phase 4 acceptance collection covering retrieval, context optimization, tenant isolation, prompt-injection resistance and /api/chat RAG orchestration."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "knowledgeBaseId",
      "value": "0eb5245e-bbb9-4a36-b928-cdbec592641b"
    },
    {
      "key": "tenantAApiKey",
      "value": ""
    },
    {
      "key": "tenantBApiKey",
      "value": ""
    },
    {
      "key": "promptInjectionFilePath",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Search VECTOR",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{tenantBApiKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/knowledge-bases/{{knowledgeBaseId}}/search",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"How does tenant isolation protect retrieval?\",\n  \"topK\": 5,\n  \"minScore\": 0.7,\n  \"retrievalStrategy\": \"VECTOR\",\n  \"candidateLimit\": 50,\n  \"queryTransformation\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const j=pm.response.json(); pm.test('all results meet minScore',()=>j.results.every(r=>r.similarity>=0.70));"
            ]
          }
        }
      ]
    },
    {
